# Where llm-gateway-guardrails is running, and its admin token (GATEWAY_ADMIN_TOKEN there).
GATEWAY_URL=http://localhost:8787
GATEWAY_ADMIN_TOKEN=change-me
# Signs session cookies. Use a long random string: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string
# "on" shows the demo sign-in buttons (Admin / Viewer). Turn off when wiring a real identity provider.
DEMO_LOGIN=on
